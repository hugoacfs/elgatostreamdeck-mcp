# streamdeck-mcp HTTP service — environment template.
# Copy to .env (or export in your shell / service unit) and fill in.

# Where the service listens. 127.0.0.1 = local machine only;
# use a private/tailnet interface address for a remote agent.
DECK_MCP_BIND=127.0.0.1:18802

# Bearer token file (chmod 600). Re-read on every request:
# rotate by replacing the file, no restart needed.
# Generate: openssl rand -hex 24 > .token && chmod 600 .token
DECK_MCP_TOKEN_FILE=./.token

# Optional overrides
# DECK_MCP_PROFILES_DIR=
# DECK_MCP_SCRIPTS_DIR=~/StreamDeckScripts
# DECK_MCP_ICONS_DIR=
# DECK_MCP_LOG=./logs/service.jsonl
